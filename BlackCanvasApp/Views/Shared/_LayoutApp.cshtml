<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — BlankCanvasApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/LayoutApp.css" />
</head>
<body class="app-body">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- SIDEBAR                                                -->
    <!-- ══════════════════════════════════════════════════════ -->
    <aside class="app-sidebar">

        <!-- Logo -->
        <a href="/" class="sidebar-logo">
            <img src="~/images/bc logo blanco.png" alt="BlankCanvas" width="80" />
        </a>

        <!-- Nav items -->
        <nav class="sidebar-nav">

            @if (User.HasClaim("permission", "clientes.ver"))
            {
                <a class="sidebar-item @(ViewData["ActivePage"]?.ToString() == "Clientes" ? "active" : "")"
                       asp-controller="Customer" asp-action="CustomerList"
                       title="Clientes">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="7" r="4" />
                        <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        <path d="M21 21v-2a4 4 0 0 0-3-3.87" />
                    </svg>
                    <span class="sidebar-label">Clientes</span>
                </a>
            }

            @if (User.HasClaim("permission", "facturas.ver"))
            {
                <a class="sidebar-item @(ViewData["ActivePage"]?.ToString() == "Facturas" ? "active" : "")"
                       asp-controller="Invoice" asp-action="Index"
                       title="Facturación">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    <span class="sidebar-label">Facturas</span>
                </a>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("Supervisor"))
            {
                <a class="sidebar-item @(ViewData["ActivePage"]?.ToString() == "Reportes" ? "active" : "")"
                       href="#" title="Reportes">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                        <path d="M2 20h20" />
                    </svg>
                    <span class="sidebar-label">Reportes</span>
                </a>
            }

        </nav>

        <!-- Bottom: settings -->
        <div class="sidebar-bottom">
            @if (User.IsInRole("Admin"))
            {
                <a class="sidebar-item @(ViewData["ActivePage"]?.ToString() == "Configuracion" ? "active" : "")"
                       href="#" title="Configuración">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33
                        1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33
                        l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4
                        h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06
                        A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51
                        a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9
                        a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                    <span class="sidebar-label">Config.</span>
                </a>
            }
        </div>
    </aside>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- MAIN AREA                                              -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="app-main">

        <!-- Top header -->
        <header class="app-header">
            <h1 class="app-header-title">@ViewData["Title"]</h1>

            <!-- User dropdown -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                var userName = User.Identity.Name ?? "Usuario";
                var inicial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
                var rol = User.IsInRole("Admin") ? "Administrador"
                             : User.IsInRole("Supervisor") ? "Supervisor"
                             : User.IsInRole("Auxiliar") ? "Auxiliar"
                             : User.IsInRole("Cliente") ? "Cliente"
                             : "Usuario";

                <div class="dropdown user-dropdown">
                    <a class="user-toggle dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                        <span class="user-avatar">@inicial</span>
                        <span class="user-name-text">@userName</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end user-menu">

                        <li>
                            <div class="user-menu-info">
                                <span class="um-name">@userName</span>
                                <span class="um-role">
                                    <i class="bi bi-shield-check"></i> @rol
                                </span>
                                <span class="um-email">
                                    @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                                </span>
                            </div>
                        </li>

                        <li>
                            <a class="dropdown-item um-item" asp-controller="Profile" asp-action="Edit">
                                <i class="bi bi-person"></i> Mi Perfil
                            </a>
                        </li>

                        <li><hr class="dropdown-divider" /></li>

                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item um-item text-danger w-100 border-0 bg-transparent text-start">
                                    <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </header>

        <!-- Page content -->
        <main class="app-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="app-footer">
            <small>© 2026 BlankCanvasApp — Para ti, ken, con mucho amor ❤️‍🩹 Att: tony</small>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
