@model BlackCanvasApp.ViewModels.AuthModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Sistema de Facturación</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>

    <!-- ===== LOGIN SCREEN ===== -->
    <div class="auth-page" id="page-login">
        <div class="auth-card card-login">

            <div class="auth-header">
                <h1 class="auth-title">Hola de Nuevo!</h1>
                <p class="auth-subtitle">Inicia sesión para continuar</p>
            </div>

            <form class="auth-form" id="form-login" asp-controller="Auth" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="alert alert-error" role="alert">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <div class="input-group @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "has-error" : "")" id="group-login-email">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                        </svg>
                    </span>
                    <input class="auth-input"
                           type="email"
                           asp-for="Email"
                           placeholder="Correo electrónico"
                           autocomplete="email" />
                    <span class="input-error">
                        <span asp-validation-for="Email"></span>
                    </span>
                </div>

                <div class="input-group @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "has-error" : "")" id="group-login-password">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <input class="auth-input"
                           type="password"
                           asp-for="Password"
                           placeholder="Contraseña"
                           autocomplete="current-password" />
                    <button type="button" class="toggle-password" data-target="Password" aria-label="Mostrar contraseña">
                        <svg class="icon-eye" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="icon-eye-off" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                    </button>
                    <span class="input-error">
                        <span asp-validation-for="Password"></span>
                    </span>
                </div>

                <button  type="submit" class="auth-btn btn-primary" id="btn-login">
                    <span class="btn-text">Acceder</span>

                    <span class="btn-spinner" aria-hidden="true"></span>
                </button>

                <a href="#" class="forgot-link" id="link-forgot">¿Olvidaste tu contraseña?</a>

                <div class="divider">
                    <span class="divider-text">¿No tienes cuenta?</span>
                </div>

                <a asp-controller="Auth" asp-action="Register" class="auth-btn btn-outline" style="text-decoration:none; line-height:50px; text-align:center;">
                    Crear cuenta
                </a>

            </form>
        </div>
    </div>

    <!-- ===== FORGOT PASSWORD MODAL ===== -->
    <div class="modal-overlay hidden" id="modal-forgot" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-card">
            <button class="modal-close" id="btn-close-modal" aria-label="Cerrar">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
            <h2 class="modal-title" id="modal-title">Reset Password</h2>
            <p class="modal-text">Ingresa tu correo y te enviaremos un enlace para restablecer tu contraseña.</p>

            <form id="form-forgot" asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="input-group" id="group-forgot-email" style="margin-bottom:14px;">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                        </svg>
                    </span>
                    <input class="auth-input" type="email" id="forgot-email" name="email" placeholder="Email Address" required />
                    <span class="input-error" id="error-forgot-email"></span>
                </div>

                <div class="alert alert-success hidden" id="alert-forgot-success" role="status" aria-live="polite"></div>

                <button type="submit" class="auth-btn btn-primary" id="btn-forgot">
                    <span class="btn-text">Send Reset Link</span>
                    <span class="btn-spinner" aria-hidden="true"></span>
                </button>
            </form>
        </div>
    </div>

    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>

