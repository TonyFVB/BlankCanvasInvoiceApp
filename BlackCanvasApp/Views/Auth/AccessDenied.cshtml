@{
    ViewData["Title"] = "Acceso Denegado";
    var returnUrl = ViewBag.ReturnUrl as string ?? "/";
}

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 65vh;">

    <div class="text-center" style="max-width: 480px;">

        <!-- Ícono -->
        <div class="mb-4" style="font-size: 72px; line-height: 1;">
            🔒
        </div>

        <!-- Código -->
        <p class="fw-bold mb-1" style="font-size: 13px; color: #6a3093; letter-spacing: 0.08em; text-transform: uppercase; font-family: 'Poppins', sans-serif;">
            Error 403
        </p>

        <!-- Título -->
        <h1 class="fw-bold mb-3" style="font-size: 28px; font-family: 'Poppins', sans-serif; color: #1a1a1a;">
            Acceso Denegado
        </h1>

        <!-- Mensaje -->
        <p class="text-muted mb-1" style="font-size: 15px; line-height: 1.6;">
            No tienes permisos para acceder a esta sección.
        </p>
        <p class="text-muted mb-4" style="font-size: 14px;">
            Si crees que esto es un error, contacta al administrador.
        </p>

        <!-- Info del rol actual -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            var rol = User.IsInRole("Admin") ? "Administrador"
                    : User.IsInRole("Supervisor") ? "Supervisor"
                    : User.IsInRole("Auxiliar") ? "Auxiliar"
                    : User.IsInRole("Cliente") ? "Cliente"
                    : "Usuario";

            <div class="mb-4 px-4 py-3 rounded-3 d-inline-flex align-items-center gap-2"
                 style="background: #f5f0fa; border: 1px solid #e0d0f0;">
                <i class="bi bi-shield-check" style="color: #6a3093;"></i>
                <span style="font-size: 13px; font-family: 'Poppins', sans-serif; color: #6a3093; font-weight: 500;">
                    Tu rol actual: <strong>@rol</strong>
                </span>
            </div>
        }

        <!-- Botones -->
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="javascript:history.back()"
                   class="btn btn-outline-secondary px-4"
                   style="border-radius: 50px; font-family: 'Poppins', sans-serif; font-size: 13px;">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <a asp-controller="Home" asp-action="Index"
                   class="btn px-4"
                   style="border-radius: 50px; background: #6a3093; color: #fff; font-family: 'Poppins', sans-serif; font-size: 13px;">
                <i class="bi bi-house"></i> Ir al inicio
            </a>
        </div>

    </div>
</div>
