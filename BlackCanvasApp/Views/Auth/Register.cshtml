@model BlackCanvasApp.ViewModels.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro — BlackCanvas</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>

    <div class="auth-page" id="page-register">
        <div class="auth-card card-register">

            <div class="auth-header">
                <h1 class="auth-title">Hola!</h1>
                <p class="auth-subtitle">Regístrate para empezar</p>
            </div>

            <form class="auth-form" id="form-register"
                  asp-controller="Auth" asp-action="Register"
                  method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="alert alert-error" role="alert">@ViewBag.ErrorMessage</div>
                }
                <div class="input-group @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "has-error" : "")" id="group-reg-lastname">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M20 21a8 8 0 1 0-16 0" />
                        </svg>
                    </span>
                    <input class="auth-input" type="text" asp-for="FullName"
                           placeholder="Nombre Completo" autocomplete="family-name" />
                    <span class="input-error"><span asp-validation-for="FullName"></span></span>
                </div>
                <!-- First Name -->
                @* <div class="input-group @(ViewData.ModelState["FirstName"]?.Errors.Count > 0 ? "has-error" : "")" id="group-reg-firstname">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M20 21a8 8 0 1 0-16 0" />
                        </svg>
                    </span>
                    <input class="auth-input" type="text" asp-for="FirstName"
                           placeholder="First Name" autocomplete="given-name" />
                    <span class="input-error"><span asp-validation-for="FirstName"></span></span>
                </div> *@

                <!-- Last Name -->
                @* <div class="input-group @(ViewData.ModelState["LastName"]?.Errors.Count > 0 ? "has-error" : "")" id="group-reg-lastname">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M20 21a8 8 0 1 0-16 0" />
                        </svg>
                    </span>
                    <input class="auth-input" type="text" asp-for="LastName"
                           placeholder="Last Name" autocomplete="family-name" />
                    <span class="input-error"><span asp-validation-for="LastName"></span></span>
                </div> *@

                <!-- Username -->
                <div class="input-group @(ViewData.ModelState["UserName"]?.Errors.Count > 0 ? "has-error" : "")" id="group-reg-username">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </span>
                    <input class="auth-input" type="text" asp-for="UserName"
                           placeholder="Nombre de Usuario" autocomplete="username" />
                    <span class="input-error"><span asp-validation-for="UserName"></span></span>
                </div>

                <!-- Email -->
                <div class="input-group @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "has-error" : "")" id="group-reg-email">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                        </svg>
                    </span>
                    <input class="auth-input" type="email" asp-for="Email"
                           placeholder="Correo electrónico" autocomplete="email" />
                    <span class="input-error"><span asp-validation-for="Email"></span></span>
                </div>

                <!-- Password -->
                <div class="input-group @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "has-error" : "")" id="group-reg-password">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <input class="auth-input" type="password" asp-for="Password"
                           placeholder="Contraseña" autocomplete="new-password" id="reg-password" />
                    <button type="button" class="toggle-password" data-target="reg-password" aria-label="Mostrar contraseña">
                        <svg class="icon-eye" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="icon-eye-off" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                    </button>

                    <!-- Indicador de fortaleza -->
                    <div class="password-strength" id="password-strength">
                        <div class="strength-bars">
                            <span class="strength-bar" id="bar-1"></span>
                            <span class="strength-bar" id="bar-2"></span>
                            <span class="strength-bar" id="bar-3"></span>
                            <span class="strength-bar" id="bar-4"></span>
                        </div>
                        <span class="strength-label" id="strength-label">Ingresa una contraseña</span>
                    </div>
                    <span class="input-error"><span asp-validation-for="Password"></span></span>
                </div>

                <!-- Confirm Password -->
                <div class="input-group @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "has-error" : "")" id="group-reg-confirm">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <input class="auth-input" type="password" asp-for="ConfirmPassword"
                           placeholder="Confirmar Contraseña" autocomplete="new-password" />
                    <button type="button" class="toggle-password" data-target="ConfirmPassword" aria-label="Mostrar contraseña">
                        <svg class="icon-eye" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="icon-eye-off" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                    </button>
                    <span class="input-error"><span asp-validation-for="ConfirmPassword"></span></span>
                </div>

                <button type="submit" class="auth-btn btn-primary" id="btn-register">
                    <span class="btn-text">Registrar</span>
                    <span class="btn-spinner" aria-hidden="true"></span>
                </button>

                <div class="divider">
                    <span class="divider-text">¿Ya tienes cuenta?</span>
                </div>

                <a asp-controller="Auth" asp-action="Login"
                       class="auth-btn btn-outline"
                       style="text-decoration:none; line-height:50px; text-align:center;">
                    Volver al Login
                </a>

            </form>
        </div>
    </div>

    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
